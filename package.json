    "axios": "1.21.1",
    "preact": "11.2.0",
    "preact-i18n": "2.4.0-preactx",
    "preact-iso": "2.12.2",
    "preact-render-to-string": "6.8.3",
    "preact-router": "4.1.2",
    "react-data-table-component": "8.13.0",
    "react-superstore": "0.1.4"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
